            local name = TreeDropdown.Value:match("^(.-)%s*%[") or TreeDropdown.Value
            if _G.WorldESPConfig then
                _G.WorldESPConfig.TreeFilter[name] = nil
                if _G.SaveESPConfig then _G.SaveESPConfig() end
            end
            Library:Notify("Removed from ESP: " .. name, 2)
        end
    })
    TreeESPToggle = ESP.Trees:AddToggle('TreeESPToggle', {
        Text = 'Tree ESP',
        Default = false,
        Callback = function(v)
            if _G.WorldESPConfig then
                _G.WorldESPConfig.TreesEnabled = v
                if _G.SaveESPConfig then _G.SaveESPConfig() end
            end
        end,
    })
    :AddColorPicker('TreeESPColor', {
        Default = Color3.fromRGB(0,255,100),
        Callback = function(v)
            if _G.WorldESPConfig then
                _G.WorldESPConfig.TreeColor = v
                if _G.SaveESPConfig then _G.SaveESPConfig() end
            end
        end
    })

    -- Fish
    FishDropdown = ESP.Fish:AddDropdown('FishDropdown', {
        Text = 'Select Fish',
        Values = {},
        Multi = false,
        AllowNull = true,
    })
    ESP.Fish:AddButton({
        Text = 'Refresh',
        Func = function()
            if _G.GetFishList then FishDropdown:SetValues(_G.GetFishList()) end
        end
    })
    ESP.Fish:AddButton({
        Text = 'Teleport to Selected',
        Func = function()
            if _G.TeleportToFish and FishDropdown and FishDropdown.Value then
                _G.TeleportToFish(FishDropdown.Value)
            end
        end
    })
    FishESPToggle = ESP.Fish:AddToggle('FishESPToggle', {
        Text = 'Big Fish ESP',
        Default = false,
        Callback = function(v)
            if _G.WorldESPConfig then
                _G.WorldESPConfig.FishEnabled = v
                if _G.SaveESPConfig then _G.SaveESPConfig() end
            end
        end,
    })
    :AddColorPicker('FishESPColor', {
        Default = Color3.fromRGB(0,200,255),
        Callback = function(v)
            if _G.WorldESPConfig then
                _G.WorldESPConfig.FishColor = v
                if _G.SaveESPConfig then _G.SaveESPConfig() end
            end
        end
    })

    -- Caves
    ESP.Caves:AddInput('CaveNameInput', {
        Text = 'Cave Name',
        Placeholder = 'Enter name...',
        Callback = function(v) CaveNameInput = v end
    })
    ESP.Caves:AddButton({
        Text = 'Save Current Position',
        Func = function()
            if CaveNameInput ~= "" and _G.SaveCavePos then
                _G.SaveCavePos(CaveNameInput)
                Library:Notify("Saved: " .. CaveNameInput, 2)
                if _G.GetCaveList and CaveDropdown then
                    CaveDropdown:SetValues(_G.GetCaveList())
                end
            end
        end
    })
    CaveDropdown = ESP.Caves:AddDropdown('CaveDropdown', {
        Text = 'Select Cave',
        Values = {},
        Multi = false,
        AllowNull = true,
    })
    ESP.Caves:AddButton({
        Text = 'Teleport to Cave',
        Func = function()
            if _G.TeleportToCave and CaveDropdown and CaveDropdown.Value then
                _G.TeleportToCave(CaveDropdown.Value)
            end
        end
    })

    -- Hitbox (Big Fish)
    _G.Config = _G.Config or {}
    _G.Config.FishHitbox = _G.Config.FishHitbox or { Enabled = false, Multiplier = 30, OriginalSizes = {} }

    ESP.HitBoxes:AddToggle('BigFishHitboxToggle', {
        Text = 'Enable BigFish Expander',
        Default = _G.Config.FishHitbox.Enabled,
        Callback = function(v)
            _G.Config.FishHitbox.Enabled = v
            if typeof(_G.updatrhitbox) == "function" then _G.updatrhitbox() end
        end,
    })
    ESP.HitBoxes:AddSlider('BigFishHitboxSize', {
        Text = 'Hitbox Size',
        Default = 25,
        Min = 5,
        Max = 150,
        Rounding = 0,
        Callback = function(v)
            if not _G.Config then _G.Config = {} end
            if not _G.Config.FishHitbox then _G.Config.FishHitbox = {} end
            _G.Config.FishHitbox.Size = Vector3.new(v,v,v)
            if _G.Config.FishHitbox.Enabled and typeof(_G.updatrhitbox) == "function" then _G.updatrhitbox() end
        end
    })
    ESP.HitBoxes:AddSlider('BigFishHitboxTrans', {
        Text = 'Transparency',
        Default = 0.7,
        Min = 0,
        Max = 1,
        Rounding = 2,
        Callback = function(v)
            if not _G.Config then _G.Config = {} end
            if not _G.Config.FishHitbox then _G.Config.FishHitbox = {} end
            _G.Config.FishHitbox.Transparency = v
            if _G.Config.FishHitbox.Enabled and typeof(_G.updatrhitbox) == "function" then _G.updatrhitbox() end
        end
    })

    ESP.HitBoxes:AddToggle('AutoFarmToggle', {
        Text = 'Включить Авто-Фарм',
        Default = false,
        Callback = function(v)
            if _G.Config then
                if not _G.Config.AutoFarm then _G.Config.AutoFarm = {} end
                _G.Config.AutoFarm.Enabled = v
            end
            if _G.SaveConfig then _G.SaveConfig() end
        end,
    })

    -- Загрузка WorldESP
    ESP.Ores:AddButton({
        Text = 'RefineryCaves 2 Script',
        Func = function()
            if _G.WorldESPLoaded then
                Library:Notify('WorldESP уже загружен', 2)
                return
            end
            RunRegisteredScript("WorldESP")
            task.wait(1)
            _G.WorldESPLoaded = true
            if _G.WorldESPConfig then
                if OreESPToggle  then OreESPToggle:SetValue(_G.WorldESPConfig.OresEnabled  or false) end
                if TreeESPToggle then TreeESPToggle:SetValue(_G.WorldESPConfig.TreesEnabled or false) end
                if FishESPToggle then FishESPToggle:SetValue(_G.WorldESPConfig.FishEnabled  or false) end
            end
            if _G.GetOreList  then OreDropdown:SetValues(_G.GetOreList(oreFilter))    end
            if _G.GetTreeList then TreeDropdown:SetValues(_G.GetTreeList(treeFilter)) end
            if _G.GetFishList then FishDropdown:SetValues(_G.GetFishList())           end
            if _G.GetCaveList then CaveDropdown:SetValues(_G.GetCaveList())           end
            Library:Notify("WorldESP loaded!", 3)
        end
    })

    -- Автообновление списков
    task.spawn(function()
        while true do
            task.wait(0.5)
            if Library.Unloaded then break end
            if _G.GetOreList  and OreDropdown  then OreDropdown:SetValues(_G.GetOreList(oreFilter))    end
            if _G.GetTreeList and TreeDropdown then TreeDropdown:SetValues(_G.GetTreeList(treeFilter)) end
            if _G.GetFishList and FishDropdown then FishDropdown:SetValues(_G.GetFishList())           end
            if _G.GetCaveList and CaveDropdown then CaveDropdown:SetValues(_G.GetCaveList())           end
        end
    end)

    -- Внешние скрипты
    RegistryLeft:AddButton('Dark Dex V4',    function() RunRegisteredScript("Dex")           end)
    RegistryLeft:AddButton('Infinite Yield', function() RunRegisteredScript("InfiniteYield") end)
    RegistryLeft:AddButton('Cobalt',         function() RunRegisteredScript("Cobalt")        end)
    RegistryLeft:AddButton('SimpleSpy V3',   function() RunRegisteredScript("SimpleSpy")     end)
    RegistryLeft:AddButton('Shaders',        function() RunRegisteredScript('Shaders')       end)
    RegistryLeft:AddButton('Animation',      function() RunRegisteredScript('Animation')     end)

    -- ============================
    -- TAB: SETTINGS
    -- ============================
    local KeyInfoGroup = Tabs.Settings:AddRightGroupbox('Информация о ключе')

-- Создаем отдельные метки под каждую строчку
local KeyLabel       = KeyInfoGroup:AddLabel('Ключ: Загрузка...')
local DurationLabel  = KeyInfoGroup:AddLabel('Срок: Загрузка...')
local RemainingLabel = KeyInfoGroup:AddLabel('Осталось: Загрузка...')

task.spawn(function()
    while true do
        task.wait(1)
        if Library.Unloaded then break end
        
        local info = GetKeyInfo()
        if info then
            KeyLabel:SetText("Ключ: " .. tostring(info.key))
            DurationLabel:SetText("Срок: " .. tostring(info.duration))
            
            if info.duration ~= "forever" and info.remaining and info.remaining > 0 then
                local days    = math.floor(info.remaining / 86400)
                local hours   = math.floor((info.remaining % 86400) / 3600)
                local minutes = math.floor((info.remaining % 3600) / 60)
                local seconds = math.floor(info.remaining % 60)
                
                RemainingLabel:SetText(string.format("Осталось: %02dд %02dч %02dм %02dс", days, hours, minutes, seconds))
            elseif info.duration == "forever" then
                RemainingLabel:SetText("Осталось: ∞ (навсегда)")
            else
                RemainingLabel:SetText("Осталось: истёк или неизвестно")
            end
        else
            KeyLabel:SetText("Информация о ключе недоступна")
            DurationLabel:SetText("")
            RemainingLabel:SetText("")
        end
    end
end)
    local MenuGroup = Tabs.Settings:AddLeftGroupbox('Menu Management')
    MenuGroup:AddLabel('Menu Key')
        :AddKeyPicker('MenuKeybind', {
            Default = 'RightShift',
            NoUI = true,
            Text = 'Menu Keybind',
            Callback = function() Library:Toggle() end,
        })
    MenuGroup:AddButton('Show Keybinds List', function()
        if Library.KeybindFrame then
            Library.KeybindFrame.Visible = not Library.KeybindFrame.Visible
        end
    end)
    MenuGroup:AddButton('Unload Cheat Completely', function() Library:Unload() end)

    -- ==================== ВЫГРУЗКА ====================
    Library:OnUnload(function()
        pcall(function() FOVCircle:Destroy() end)
        pcall(function() AimBotFOVCircle:Destroy() end)
        pcall(function() SilentAimTracer:Destroy() end)
        pcall(function() TargetHUD_Screen:Destroy() end)
        pcall(function() HitLogGui:Destroy() end)
        for _, l in pairs(CrosshairLines) do pcall(function() l:Remove() end) end
        RemoveAllHighlights()
        RemoveAllForceFields()
        RemoveAllMechChams()
        DestroyFlyObjects()
        if SpinVelocity then pcall(function() SpinVelocity:Destroy() end); SpinVelocity = nil end
        for _, cache in pairs(ESPCache) do
            pcall(function() if cache.NameTag  then cache.NameTag:Remove()    end end)
            pcall(function() if cache.Tracer   then cache.Tracer:Remove()     end end)
            pcall(function() if cache.Highlight then cache.Highlight:Destroy() end end)
            if cache.Bones    then for _, b in pairs(cache.Bones)    do pcall(function() b:Remove() end) end end
            if cache.BoxLines then for _, l in pairs(cache.BoxLines) do pcall(function() l:Remove() end) end end
        end
        for _, name in ipairs({"LunarColor","LunarBloom","LunarBlur","LunarSun"}) do
            local e = Lighting:FindFirstChild(name)
            if e then pcall(function() e:Destroy() end) end
        end
        RemoveSilentAimHooks()
        Workspace.Gravity = OriginalGravity
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end)

    -- ==================== МЕНЕДЖЕРЫ ====================
    task.spawn(function()
        repeat task.wait(0.1) until ThemeManager and SaveManager
            and type(ThemeManager.SetLibrary) == "function"
            and type(SaveManager.SetLibrary)  == "function"

        ThemeManager:SetLibrary(Library)
        SaveManager:SetLibrary(Library)
        ThemeManager:SetFolder('LunarHub')
        SaveManager:SetFolder('LunarHub/configs')
        SaveManager:BuildConfigSection(Tabs.Settings)
        ThemeManager:ApplyToTab(Tabs.Settings)
        pcall(function() SaveManager:LoadAutoloadConfig() end)
    end)
end

-- ================================================================
--  ЗАПУСК: ПРОВЕРКА СОХРАНЁННОГО КЛЮЧА → GUI ИЛИ СРАЗУ ЗАГРУЗКА
-- ================================================================
local function Start()
    local hwid      = GetHWID()
    local savedKey  = LoadSavedKey()

    if savedKey and savedKey ~= "" then
        local result = ValidateKey(savedKey, hwid)
        if result == "ok" then
            LoadMainScript()
        else
            pcall(function() writefile(KEY_FILE, "") end)
            ShowKeyGUI(LoadMainScript)
        end
    else
        ShowKeyGUI(LoadMainScript)
    end
end

Start()
