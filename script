    local function HookedNamecall(self, ...)
        if checkcaller() then return OriginalFunctions.Namecall(self, ...) end
        local method = getnamecallmethod()
        local args   = {...}
        if Config.SilentAimEnabled and CachedSilentTarget and CalculateChance(Config.SilentAimHitChance) then
            if self == Workspace and method == "Raycast" and Config.SilentAimMethod == "Raycast" then
                if args[1] and typeof(args[1]) == "Vector3" then
                    args[2] = getDirection(args[1], CachedSilentTarget.Position)
                    return OriginalFunctions.Namecall(self, table.unpack(args))
                end
            end
        end
        return OriginalFunctions.Namecall(self, ...)
    end

    local function HookedIndex(self, index)
        if checkcaller() then return OriginalFunctions.Index(self, index) end
        if Config.SilentAimEnabled and self == Mouse and CachedSilentTarget then
            if Config.SilentAimMethod == "Mouse.Hit/Target" then
                if index == "Target" or index == "target" then
                    return CachedSilentTarget
                elseif index == "Hit" or index == "hit" then
                    if Config.MouseHitPrediction then
                        return CachedSilentTarget.CFrame
                            + (CachedSilentTarget.Velocity * Config.MouseHitPredictionAmount)
                    end
                    return CachedSilentTarget.CFrame
                end
            end
        end
        return OriginalFunctions.Index(self, index)
    end

    local function ApplySilentAimHooks()
        if HooksApplied then return end
        HooksApplied = true
        OriginalFunctions.Namecall = hookmeta(game, "__namecall", newcclosure(HookedNamecall))
        OriginalFunctions.Index    = hookmeta(game, "__index",    newcclosure(HookedIndex))
    end

    local function RemoveSilentAimHooks()
        if not HooksApplied then return end
        HooksApplied = false
        if OriginalFunctions.Namecall then
            hookmeta(game, "__namecall", OriginalFunctions.Namecall)
        end
        if OriginalFunctions.Index then
            hookmeta(game, "__index", OriginalFunctions.Index)
        end
        table.clear(OriginalFunctions)
    end

