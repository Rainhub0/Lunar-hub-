    local function CleanupGarbage()
        local logs = HitLogFrame:GetChildren()
        if #logs > 20 then
            for i = 1, #logs - 20 do
                if logs[i]:IsA("TextLabel") then
                    logs[i]:Destroy()
                end
            end
        end
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Part") and obj.Anchored and obj.CanCollide == false and obj.Transparency > 0.9 then
                pcall(obj.Destroy, obj)
            end
        end
    end

    task.spawn(function()
        while true do
            task.wait(30)
            pcall(CleanupGarbage)
        end
    end)

