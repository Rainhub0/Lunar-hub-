-- ================================================================
--  HWID ПОЛУЧЕНИЕ
-- ================================================================
local function GetHWID()
    if getdeviceid then
        local ok, result = pcall(getdeviceid)
        if ok and result and result ~= "" then
            return tostring(result):upper()
        end
    end
    if getmacaddress then
        local ok, result = pcall(getmacaddress)
        if ok and result and result ~= "" then
            return tostring(result):upper():gsub("[^%w]","")
        end
    end
    local userId = tostring(Players.LocalPlayer.UserId)
    local name   = tostring(Players.LocalPlayer.Name)
    local str    = userId .. name .. "LunarHub2025"
    local hash   = 0
    for i = 1, #str do
        hash = (hash * 31 + string.byte(str, i)) % 0xFFFFFFFF
    end
    return string.format("HWID-%08X", hash)
end

