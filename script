    -- Shaders (без изменений)
    ShadersGroup:AddDropdown('LunarShadersPreset', {
        Text = 'Shader Preset',
        Values = {'Default','Vibrant Retro','Cyber Midnight','Warm Sunset','Cinematic RT','Silent Hill','Deep Space','Acid Trip','Dreamy','Monochrome','RTX'},
        Default = 1,
        Multi = false,
        Callback = function(Value)
            for _, name in ipairs({"LunarColor","LunarBloom","LunarBlur","LunarSun"}) do
                local e = Lighting:FindFirstChild(name)
                if e then e:Destroy() end
            end
            Lighting.Ambient              = OriginalLighting.Ambient
            Lighting.OutdoorAmbient       = OriginalLighting.OutdoorAmbient
            Lighting.Brightness           = OriginalLighting.Brightness
            Lighting.GlobalShadows        = OriginalLighting.GlobalShadows
            Lighting.ExposureCompensation = OriginalLighting.ExposureCompensation
            if not Config.NoFog then Lighting.FogEnd = OriginalLighting.FogEnd end

            local function cc(b,c,s,t)
                local e = Instance.new("ColorCorrectionEffect",Lighting); e.Name="LunarColor"
                e.Brightness=b; e.Contrast=c; e.Saturation=s
                if t then e.TintColor=t end
            end
            local function bloom(i,sz,th)
                local e=Instance.new("BloomEffect",Lighting); e.Name="LunarBloom"
                e.Intensity=i; e.Size=sz; e.Threshold=th
            end

            if     Value=="Vibrant Retro"  then cc(0.05,0.25,0.5); bloom(0.6,12,0.8)
            elseif Value=="Cyber Midnight" then
                Lighting.Ambient=Color3.fromRGB(15,15,35); Lighting.OutdoorAmbient=Color3.fromRGB(20,20,45); Lighting.Brightness=1.2
                cc(-0.08,0.4,0.3,Color3.fromRGB(210,190,255)); bloom(1.2,24,0.2)
            elseif Value=="Warm Sunset" then
                Lighting.OutdoorAmbient=Color3.fromRGB(75,45,35)
                cc(0.02,0.2,0.55,Color3.fromRGB(255,210,170))
                local s=Instance.new("SunRaysEffect",Lighting); s.Name="LunarSun"; s.Intensity=0.25; s.Spread=0.85
            elseif Value=="Cinematic RT" then
                Lighting.GlobalShadows=true; Lighting.ExposureCompensation=0.15
                cc(-0.02,0.35,0.15); bloom(0.4,8,0.95)
            elseif Value=="Silent Hill" then
                Lighting.Ambient=Color3.fromRGB(90,90,90); Lighting.OutdoorAmbient=Color3.fromRGB(110,110,110); Lighting.FogEnd=150
                cc(0,-0.1,-0.7)
            elseif Value=="Deep Space" then
                Lighting.Ambient=Color3.fromRGB(0,0,0); Lighting.OutdoorAmbient=Color3.fromRGB(5,5,15); Lighting.Brightness=0
                cc(0,0.4,0.1); bloom(2,35,0.05)
            elseif Value=="Acid Trip" then
                cc(0,0.6,2.5,Color3.fromRGB(255,100,255))
                local b=Instance.new("BlurEffect",Lighting); b.Name="LunarBlur"; b.Size=5
            elseif Value=="Dreamy" then
                Lighting.Ambient=Color3.fromRGB(255,220,220); Lighting.OutdoorAmbient=Color3.fromRGB(255,230,230)
                cc(0.1,0,-0.2); bloom(1,24,0.4)
            elseif Value=="Monochrome" then cc(0,0.3,-1)
            elseif Value=="RTX" then
                Lighting.Brightness=1.5; Lighting.GlobalShadows=true
                cc(0,0.3,0.2,Color3.fromRGB(240,245,255)); bloom(0.5,20,0.6)
                local b=Instance.new("BlurEffect",Lighting); b.Name="LunarBlur"; b.Size=2
            end
        end,
    })

