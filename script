-- Функции для работы с активациями
local function GetActivationTime(key)
    local ok, data = pcall(function() return readfile(ACTIVATIONS_FILE) end)
    if not ok or not data then return nil end
    for line in data:gmatch("[^\r\n]+") do
        local k, ts = line:match("^(.-):(%d+)$")
        if k == key then
            return tonumber(ts)
        end
    end
    return nil
end

local function SetActivationTime(key, timestamp)
    local ok, data = pcall(function() return readfile(ACTIVATIONS_FILE) end)
    local lines = {}
    if ok and data then
        for line in data:gmatch("[^\r\n]+") do
            local k = line:match("^(.-):")
            if k ~= key then
                table.insert(lines, line)
            end
        end
    end
    table.insert(lines, key .. ":" .. tostring(timestamp))
    pcall(function() writefile(ACTIVATIONS_FILE, table.concat(lines, "\n")) end)
end

-- ================================================================
--  ЗАГРУЗКА И ПРОВЕРКА КЛЮЧЕЙ (с учётом срока)
-- ================================================================
local function FetchLines(url)
    local ok, result = pcall(function() return game:HttpGet(url) end)
    if not ok then return {} end
    local lines = {}
    for line in result:gmatch("[^\r\n]+") do
        local trimmed = line:match("^%s*(.-)%s*$")
        if trimmed ~= "" then
            table.insert(lines, trimmed)
        end
    end
    return lines
end

local function ValidateKey(enteredKey, hwid)
    local keyLines = FetchLines(KEYS_URL)
    if #keyLines == 0 then return "error" end

    local keyData = nil  -- { key, duration, storedHwid }
    for _, line in ipairs(keyLines) do
        -- Пробуем новый формат: ключ:срок:HWID
        local k, dur, h = line:match("^(.-):(.-):(.-)$")
        if k and dur and h then
            if k == enteredKey then
                keyData = { key = k, duration = dur, hwid = h }
                break
            end
        else
            -- Старый формат: ключ:HWID (срок считаем "forever")
            local k, h = line:match("^(.-):(.-)$")
            if k and k == enteredKey then
                keyData = { key = k, duration = "forever", hwid = h }
                break
            elseif line == enteredKey then
                -- Совсем старый (без HWID) – FREE и forever
                keyData = { key = line, duration = "forever", hwid = "FREE" }
                break
            end
        end
    end

    if not keyData then return "bad_key" end

    -- Проверка HWID (если ключ не FREE)
    if keyData.hwid ~= "FREE" and keyData.hwid ~= hwid then
        return "bad_hwid"
    end

    -- Проверка срока действия
    if keyData.duration ~= "forever" then
        local activationTime = GetActivationTime(enteredKey)
        if not activationTime then
            -- Первая активация → запоминаем текущее время
            activationTime = os.time()
            SetActivationTime(enteredKey, activationTime)
        end
        -- Переводим срок в секунды
        local num, unit = keyData.duration:match("^(%d+)(%a)$")
        if num and unit then
            local seconds = tonumber(num)
            if unit == "d" then seconds = seconds * 86400
            elseif unit == "h" then seconds = seconds * 3600
            elseif unit == "m" then seconds = seconds * 60
            else return "error"
            end
            if os.time() - activationTime > seconds then
                return "expired"
            end
        else
            return "error"
        end
    end

    -- Если всё ок, возвращаем "ok"
    return "ok"
end

-- ================================================================
--  ОТПРАВКА В ВЕБХУК (с фото, если возможно)
-- ================================================================
local function SendWebhook(username, hwid, key)
    if WEBHOOK_URL == "" then return end

    local data = {
        content = nil,
        embeds = {{
            title = "🔑 Новая активация!",
            color = 0x00FF00,
            fields = {
                { name = "👤 Игрок", value = username, inline = true },
                { name = "🖥️ HWID", value = hwid, inline = true },
                { name = "🔐 Ключ", value = key, inline = false },
                { name = "⏱️ Дата", value = os.date("%Y-%m-%d %H:%M:%S"), inline = false }
            }
        }}
    }

    -- Пытаемся сделать скриншот
    local screenshotData = nil
    if saveviewport then
        local ok, result = pcall(function()
            local name = "LunarHub_screenshot.png"
            saveviewport(name)
            return readfile(name)
        end)
        if ok and result then
            screenshotData = result
        end
    elseif game:GetService("Workspace"):GetCamera().SaveViewportToFile then
        local ok, result = pcall(function()
            local name = "LunarHub_screenshot.png"
            game:GetService("Workspace"):GetCamera():SaveViewportToFile(name)
            return readfile(name)
        end)
        if ok and result then
            screenshotData = result
        end
    end

    -- Формируем multipart/form-data, если есть скриншот
    if screenshotData then
        local boundary = "----LunarHubBoundary" .. tostring(math.random(100000, 999999))
        local body = ""
        for k, v in pairs(data) do
            if type(v) == "string" then
                body = body .. "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"" .. k .. "\"\r\n\r\n" .. v .. "\r\n"
            elseif type(v) == "table" then
                body = body .. "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"" .. k .. "\"\r\nContent-Type: application/json\r\n\r\n" .. HttpService:JSONEncode(v) .. "\r\n"
            end
        end
        body = body .. "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"file\"; filename=\"screenshot.png\"\r\nContent-Type: image/png\r\n\r\n" .. screenshotData .. "\r\n"
        body = body .. "--" .. boundary .. "--"

        pcall(function()
            HttpService:RequestAsync({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "multipart/form-data; boundary=" .. boundary,
                    ["Content-Length"] = #body
                },
                Body = body
            })
        end)
    else
        -- Отправляем только JSON
        pcall(function()
            HttpService:RequestAsync({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(data)
            })
        end)
    end
end

