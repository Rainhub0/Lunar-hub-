	-- ===== ФУНКЦИИ ДЛЯ ИНФОРМАЦИИ О КЛЮЧЕ =====
local function ParseDuration(dur)
    if dur == "forever" then return nil end
    local num, unit = dur:match("^(%d+)(%a)$")
    if num and unit then
        local seconds = tonumber(num)
        if unit == "d" then seconds = seconds * 86400
        elseif unit == "h" then seconds = seconds * 3600
        elseif unit == "m" then seconds = seconds * 60
        else return 0 end
        return seconds
    end
    return 0
end

local function GetKeyInfo()
    local key = LoadSavedKey()
    if not key then return nil end
    local keyLines = FetchLines(KEYS_URL)
    local duration = "unknown"
    for _, line in ipairs(keyLines) do
        -- Новый формат: ключ:срок:HWID
        local k, dur, h = line:match("^(.-):(.-):(.-)$")
        if k and k == key then
            duration = dur
            break
        end
        -- Старый формат: ключ:HWID (считаем forever)
        local k_old, h_old = line:match("^(.-):(.-)$")
        if k_old and k_old == key then
            duration = "forever"
            break
        end
        -- Совсем старый: просто ключ
        if line == key then
            duration = "forever"
            break
        end
    end
    local activationTime = GetActivationTime(key)
    local remaining = nil
    if duration ~= "forever" and duration ~= "unknown" and activationTime then
        local totalSec = ParseDuration(duration)
        if totalSec then
            remaining = activationTime + totalSec - os.time()
        end
    end
    return {
        key = key,
        duration = duration,
        activationTime = activationTime,
        remaining = remaining,
    }
end

