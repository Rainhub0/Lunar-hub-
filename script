    local ValidTargetParts = {"Head","HumanoidRootPart","UpperTorso","LowerTorso","Torso"}

    local function GetClosestPlayerForSilent()
        if not Config.SilentAimEnabled then return nil end
        local closest  = nil
        local bestDist = Config.SilentAimFOV
        local mouseLoc = GetMouseLocation()

        for _, player in ipairs(CachedPlayers) do
            if Config.TeamCheck and player.Team == LocalPlayer.Team then continue end
            if Config.Whitelist[player.Name] then continue end
            local char = player.Character
            if not char then continue end
            local hum  = FindFirstChild(char, "Humanoid")
            local root = FindFirstChild(char, "HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then continue end
            if Config.VisibleCheck and not IsPlayerVisible(player) then continue end

            local screenPos, onScreen = WorldToViewportPoint(root.Position)
            if not onScreen then continue end

            local dist = (mouseLoc - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
            if dist <= bestDist then
                local targetPartName = Config.SilentAimTargetPart
                if targetPartName == "Random" then
                    targetPartName = ValidTargetParts[math.random(1, #ValidTargetParts)]
                end
                closest          = FindFirstChild(char, targetPartName) or root
                bestDist         = dist
                LastTargetPlayer = player
            end
        end
        return closest
    end

