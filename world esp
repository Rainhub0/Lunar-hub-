task.spawn(function()
    local AttackEvent
    repeat
        AttackEvent = ReplicatedStorage:FindFirstChild("Events")
            and ReplicatedStorage.Events:FindFirstChild("Tools")
            and ReplicatedStorage.Events.Tools:FindFirstChild("Attack")
        task.wait(0.1)
    until AttackEvent

    local mt          = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        if self == AttackEvent then
            local method = getnamecallmethod()
            if method == "FireServer" then
                local args = {...}
                if type(args[1]) == "table" then
                    args[1].Alpha        = 0.995 + math.random() * 0.004
                    args[1].ResponseTime = 0.955 + math.random() * 0.005
                end
                return oldNamecall(self, table.unpack(args))
            end
        end
        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
    print("[PerfectCatch] Loaded!")
end)

