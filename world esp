--                       VEHICLE TELEPORT SYSTEM
-- ====================================================================
local savedVehicleCFrame = nil

local function getTargetRoot()
    local character = LocalPlayer.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    if humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
        local vehicle = humanoid.SeatPart.Parent
        return vehicle.PrimaryPart or humanoid.SeatPart, true
    elseif humanoid.SeatPart then
        return humanoid.SeatPart.Parent.PrimaryPart or humanoid.SeatPart, true
    else
        return character:FindFirstChild("HumanoidRootPart"), false
    end
end

local function saveVehiclePos()
    local root = getTargetRoot()
    if root then savedVehicleCFrame = root.CFrame; print("[VehicleTP] Точка сохранена!") end
end

local function tpVehicleToSaved()
    if not savedVehicleCFrame then warn("[VehicleTP] Точка еще не сохранена!"); return end
    local root, isVehicle = getTargetRoot()
    if root then
        if isVehicle then
            local vehicle = root:FindFirstAncestorOfClass("Model") or root.Parent
            for _, part in ipairs(vehicle:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.AssemblyLinearVelocity  = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
        root.CFrame = savedVehicleCFrame + Vector3.new(0, 2, 0)
        print("[VehicleTP] Телепорт выполнен!")
    end
end

