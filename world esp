--                           HELPERS & TELEPORTS
-- ====================================================================
local function getObjectList(folder, filter)
    local list = {}
    if not folder then return list end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos  = myRoot and myRoot.Position
    for _, obj in ipairs(folder:GetChildren()) do
        if isDecoration(obj.Name) then continue end
        local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if not root then continue end
        if filter and filter ~= "" then
            if not obj.Name:lower():find(filter:lower(), 1, true) then continue end
        end
        local dist = myPos and math.floor((myPos - root.Position).Magnitude) or 0
        table.insert(list, obj.Name .. " [" .. dist .. "m]")
    end
    table.sort(list, function(a, b)
        local da = tonumber(a:match("%[(%d+)m%]")) or 0
        local db = tonumber(b:match("%[(%d+)m%]")) or 0
        return da < db
    end)
    return list
end

local function teleportToObject(folder, selectedName)
    if not folder or not selectedName then return end
    local baseName = selectedName:match("^(.-)%s*%[") or selectedName
    local myRoot   = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local bestDist, bestRoot = math.huge, nil
    local myPos = myRoot.Position
    for _, obj in ipairs(folder:GetChildren()) do
        if obj.Name == baseName then
            local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if root then
                local dist = (myPos - root.Position).Magnitude
                if dist < bestDist then bestDist = dist; bestRoot = root end
            end
        end
    end
    if bestRoot then myRoot.CFrame = CFrame.new(bestRoot.Position + Vector3.new(0, 5, 0)) end
end

