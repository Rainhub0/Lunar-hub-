local function getFarmFolder()
    local farmCfg = _G.Config and _G.Config.AutoFarm
    if not farmCfg then return nil end
    if farmCfg.FolderType == "BigFish" then
        return Workspace:FindFirstChild("BigFish")
    else
        local ws = Workspace:FindFirstChild("WorldSpawn")
        return ws and ws:FindFirstChild(farmCfg.FolderType)
    end
end

local _farmTargetCache = nil

local function getClosestTarget()
    local farmCfg = _G.Config.AutoFarm
    local folder  = getFarmFolder()
    if not folder or not farmCfg.TargetName or farmCfg.TargetName == "" then return nil end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    if _farmTargetCache and _farmTargetCache.Parent then
        return _farmTargetCache
    end

    local myPos = myRoot.Position
    local closest, shortest = nil, math.huge

    for _, obj in ipairs(folder:GetChildren()) do
        if not isDecoration(obj.Name) and obj.Name == farmCfg.TargetName then
            local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            if root then
                local dist = (myPos - root.Position).Magnitude
                if dist < shortest then shortest = dist; closest = obj end
            end
        end
    end

    _farmTargetCache = closest
    return closest
end

task.spawn(function()
    local folder = getFarmFolder()
    if folder then
        folder.ChildRemoved:Connect(function(child)
            if _farmTargetCache == child then _farmTargetCache = nil end
        end)
    end
end)

local _eventsFolder = nil
local function getEventsFolder()
    if _eventsFolder then return _eventsFolder end
    local ev = ReplicatedStorage:FindFirstChild("Events")
    if ev then _eventsFolder = ev:FindFirstChild("Tools") end
    return _eventsFolder
end

task.spawn(function()
    while true do
        local farmCfg = _G.Config and _G.Config.AutoFarm

        if not farmCfg or not farmCfg.Enabled then
            task.wait(0.5)
            continue
        end

        local character = LocalPlayer.Character
        local myRoot    = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid  = character and character:FindFirstChildOfClass("Humanoid")

        if myRoot and humanoid then
            local targetObj = getClosestTarget()
            if targetObj then
                local targetPart = targetObj.PrimaryPart or targetObj:FindFirstChildWhichIsA("BasePart")
                if targetPart then
                    local targetPos = targetPart.Position
                    local spawnPos  = targetPos + (farmCfg.DistanceOffset or Vector3.new(0, 3, 3))
                    myRoot.CFrame   = CFrame.lookAt(spawnPos, targetPos)

                    local tool = character:FindFirstChildOfClass("Tool")
                    if not tool then
                        local bt = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                        if bt then humanoid:EquipTool(bt); tool = bt; task.wait(0.1) end
                    end

                    if tool then tool:Activate() end

                    local evf = getEventsFolder()
                    if evf then
                        local chargeEvent = evf:FindFirstChild("Charge")
                        local attackEvent = evf:FindFirstChild("Attack")
                        if chargeEvent then chargeEvent:FireServer({Target = targetPart, HitPosition = targetPos}) end
                        if attackEvent  then attackEvent:FireServer({Target = targetPart, HitPosition = targetPos, Tool = tool}) end
                    end
                end
            end
        end

        task.wait(farmCfg.AttackDelay or 0.3)
    end
end)

-- ====================================================================
--            BIG FISH HITBOX EXPANDER
-- ====================================================================
local function applyHitbox(fishObj)
    if not fishObj or isDecoration(fishObj.Name) then return end
    local cfg = _G.Config and _G.Config.FishHitbox
    if not cfg then return end

    local hitFolder = fishObj:FindFirstChild("Hit")
    local rootPart  = hitFolder and hitFolder:FindFirstChild("RootPart")
    if not rootPart or not rootPart:IsA("BasePart") then return end

    if not cfg.OriginalSizes[rootPart] then
        cfg.OriginalSizes[rootPart] = {
            Size         = rootPart.Size,
            Transparency = rootPart.Transparency,
            CanCollide   = rootPart.CanCollide,
            Massless     = rootPart.Massless
        }
    end

    local orig = cfg.OriginalSizes[rootPart]
    if cfg.Enabled then
        if rootPart.Size ~= cfg.Size then
            rootPart.Size         = cfg.Size
            rootPart.Transparency = cfg.Transparency
            rootPart.CanCollide   = false
            rootPart.Massless     = true
        end
    else
        if rootPart.Size ~= orig.Size then
            rootPart.Size         = orig.Size
            rootPart.Transparency = orig.Transparency
            rootPart.CanCollide   = orig.CanCollide
            rootPart.Massless     = orig.Massless
        end
    end
end

_G.updatrhitbox = function()
    local bf = Workspace:FindFirstChild("BigFish")
    if not bf then return end
    for _, fishObj in ipairs(bf:GetChildren()) do applyHitbox(fishObj) end
end

task.spawn(function()
    local bigFishFolder = Workspace:WaitForChild("BigFish", 10)
    if not bigFishFolder then return end

    for _, fishObj in ipairs(bigFishFolder:GetChildren()) do applyHitbox(fishObj) end

    bigFishFolder.ChildAdded:Connect(function(child)
        task.wait(0.05)
        applyHitbox(child)
    end)

    local lastEnabled = _G.Config.FishHitbox.Enabled
    while true do
        local cur = _G.Config and _G.Config.FishHitbox and _G.Config.FishHitbox.Enabled
        if cur ~= lastEnabled then
            lastEnabled = cur
            for _, fishObj in ipairs(bigFishFolder:GetChildren()) do applyHitbox(fishObj) end
        end
        task.wait(1)
    end
end)

