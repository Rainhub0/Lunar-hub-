local OreESP  = {}
local TreeESP = {}
local FishESP = {}

local function isDecoration(name)
    local n = name:lower()
    return n:find("decorat", 1, true) or n:find("\xd0\xb4\xd0\xb5\xd0\xba\xd0\xbe\xd1\x80\xd0\xb0", 1, true)
end

local function createEntry(obj, color)
    local text = Drawing.new("Text")
    text.Visible = false
    text.Center  = true
    text.Outline = true
    text.Size    = 13
    text.Font    = 2

    local hl = Instance.new("Highlight")
    hl.FillColor           = color
    hl.OutlineColor        = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency    = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee             = obj
    hl.Enabled             = false
    hl.Parent              = LocalPlayer.PlayerGui

    return { Text = text, Highlight = hl, Obj = obj }
end

local function removeEntry(entry)
    pcall(function() entry.Text:Remove() end)
    pcall(function() entry.Highlight:Destroy() end)
end

local function setupFolderWatcher(folder, cache, colorGetter)
    if not folder then return end
    for _, obj in ipairs(folder:GetChildren()) do
        if not isDecoration(obj.Name) then
            cache[obj] = createEntry(obj, colorGetter())
        end
    end
    folder.ChildAdded:Connect(function(child)
        if isDecoration(child.Name) then return end
        task.wait()
        cache[child] = createEntry(child, colorGetter())
    end)
    folder.ChildRemoved:Connect(function(child)
        local entry = cache[child]
        if entry then removeEntry(entry); cache[child] = nil end
    end)
end

local function updateESP(cache, enabled, color, nameFilter)
    local hasFilter = nameFilter and next(nameFilter) ~= nil

    if not enabled then
        for _, entry in pairs(cache) do
            if entry.Text.Visible      then entry.Text.Visible      = false end
            if entry.Highlight.Enabled then entry.Highlight.Enabled = false end
        end
        return
    end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos  = myRoot and myRoot.Position

    for obj, entry in pairs(cache) do
        if not obj or not obj.Parent then
            removeEntry(entry)
            cache[obj] = nil
            continue
        end

        if hasFilter and not nameFilter[obj.Name] then
            if entry.Text.Visible      then entry.Text.Visible      = false end
            if entry.Highlight.Enabled then entry.Highlight.Enabled = false end
            continue
        end

        local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if not root then
            if entry.Text.Visible      then entry.Text.Visible      = false end
            if entry.Highlight.Enabled then entry.Highlight.Enabled = false end
            continue
        end

        if entry.Highlight.FillColor ~= color then entry.Highlight.FillColor = color end
        if not entry.Highlight.Enabled then entry.Highlight.Enabled = true end

        local rootPos             = root.Position
        local screenPos, onScreen = Camera:WorldToViewportPoint(rootPos)

        if not onScreen then
            if entry.Text.Visible then entry.Text.Visible = false end
            continue
        end

        local dist     = myPos and math.floor((myPos - rootPos).Magnitude) or 0
        local newLabel = obj.Name .. " [" .. dist .. "m]"
        entry.Text.Position = Vector2.new(screenPos.X, screenPos.Y - 15)
        if entry.Text.Text  ~= newLabel then entry.Text.Text  = newLabel end
        if entry.Text.Color ~= color    then entry.Text.Color = color    end
        if not entry.Text.Visible then entry.Text.Visible = true end
    end
end

-- ====================================================================
--            BIG FISH HITBOX EXPANDER
-- ====================================================================
local function applyHitbox(fishObj)
    if not fishObj or isDecoration(fishObj.Name) then return end
    local cfg = _G.Config and _G.Config.FishHitbox
    if not cfg then return end

    local hitFolder = fishObj:FindFirstChild("Hit")
    local rootPart  = hitFolder and hitFolder:FindFirstChild("RootPart")
    if not rootPart or not rootPart:IsA("BasePart") then return end

    if not cfg.OriginalSizes[rootPart] then
        cfg.OriginalSizes[rootPart] = {
            Size         = rootPart.Size,
            Transparency = rootPart.Transparency,
            CanCollide   = rootPart.CanCollide,
            Massless     = rootPart.Massless
        }
    end

    local orig = cfg.OriginalSizes[rootPart]
    if cfg.Enabled then
        if rootPart.Size ~= cfg.Size then
            rootPart.Size         = cfg.Size
            rootPart.Transparency = cfg.Transparency
            rootPart.CanCollide   = false
            rootPart.Massless     = true
        end
    else
        if rootPart.Size ~= orig.Size then
            rootPart.Size         = orig.Size
            rootPart.Transparency = orig.Transparency
            rootPart.CanCollide   = orig.CanCollide
            rootPart.Massless     = orig.Massless
        end
    end
end

_G.updatrhitbox = function()
    local bf = Workspace:FindFirstChild("BigFish")
    if not bf then return end
    for _, fishObj in ipairs(bf:GetChildren()) do applyHitbox(fishObj) end
end

task.spawn(function()
