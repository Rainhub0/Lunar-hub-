RunService.RenderStepped:Connect(function()
    local espCfg = _G.Config.WorldESP
    if not espCfg.OresEnabled and not espCfg.TreesEnabled and not espCfg.FishEnabled then return end

    updateESP(OreESP,  espCfg.OresEnabled,  espCfg.OreColor,  espCfg.OreFilter)
    updateESP(TreeESP, espCfg.TreesEnabled, espCfg.TreeColor, espCfg.TreeFilter)
