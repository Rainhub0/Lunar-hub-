local CONFIG_FILE = "LunarHub/config.json"

_G.Config = {
    FishHitbox = {
        Enabled       = false,
        Size          = Vector3.new(25, 25, 25),
        Transparency  = 0.7,
        OriginalSizes = {}
    },
    WorldESP = {
        OresEnabled  = false,
        TreesEnabled = false,
        FishEnabled  = false,
        OreColor     = Color3.fromRGB(255, 200, 0),
        TreeColor    = Color3.fromRGB(0, 255, 100),
        FishColor    = Color3.fromRGB(0, 200, 255),
        OreFilter    = {},
        TreeFilter   = {}
    },
    Caves    = {},
}

_G.WorldESPConfig = _G.Config.WorldESP

local function LoadConfig()
    if not isfile(CONFIG_FILE) then return end
    local ok, result = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if not ok or type(result) ~= "table" then return end

    if result.FishHitbox then
        _G.Config.FishHitbox.Enabled      = result.FishHitbox.Enabled or false
        _G.Config.FishHitbox.Transparency = result.FishHitbox.Transparency or 0.7
        if result.FishHitbox.Size then
            _G.Config.FishHitbox.Size = Vector3.new(
                result.FishHitbox.Size.X or 25,
                result.FishHitbox.Size.Y or 25,
                result.FishHitbox.Size.Z or 25)
        end
    end

    if result.WorldESP then
        local esp, res = _G.Config.WorldESP, result.WorldESP
        esp.OresEnabled  = res.OresEnabled  or false
        esp.TreesEnabled = res.TreesEnabled or false
        esp.FishEnabled  = res.FishEnabled  or false
        esp.OreFilter    = res.OreFilter    or {}
        esp.TreeFilter   = res.TreeFilter   or {}
        if res.OreColor  then esp.OreColor  = Color3.fromRGB(res.OreColor.R,  res.OreColor.G,  res.OreColor.B)  end
        if res.TreeColor then esp.TreeColor = Color3.fromRGB(res.TreeColor.R, res.TreeColor.G, res.TreeColor.B) end
        if res.FishColor then esp.FishColor = Color3.fromRGB(res.FishColor.R, res.FishColor.G, res.FishColor.B) end
    end

    if result.Caves then
        for name, pos in pairs(result.Caves) do
            if pos and pos.X and pos.Y and pos.Z then
                _G.Config.Caves[name] = CFrame.new(pos.X, pos.Y, pos.Z)
            end
        end
    end

local function SaveConfig()
    local ok, err = pcall(function()
        local fishCfg, espCfg = _G.Config.FishHitbox, _G.Config.WorldESP
        local cavesData = {}
        for name, cf in pairs(_G.Config.Caves) do
            cavesData[name] = {X = cf.Position.X, Y = cf.Position.Y, Z = cf.Position.Z}
        end
        writefile(CONFIG_FILE, HttpService:JSONEncode({
            FishHitbox = {
                Enabled      = fishCfg.Enabled,
                Transparency = fishCfg.Transparency,
                Size         = {X = fishCfg.Size.X, Y = fishCfg.Size.Y, Z = fishCfg.Size.Z}
            },
            WorldESP = {
                OresEnabled  = espCfg.OresEnabled,
                TreesEnabled = espCfg.TreesEnabled,
                FishEnabled  = espCfg.FishEnabled,
                OreFilter    = espCfg.OreFilter,
                TreeFilter   = espCfg.TreeFilter,
                OreColor  = {R = math.floor(espCfg.OreColor.R  * 255), G = math.floor(espCfg.OreColor.G  * 255), B = math.floor(espCfg.OreColor.B  * 255)},
                TreeColor = {R = math.floor(espCfg.TreeColor.R * 255), G = math.floor(espCfg.TreeColor.G * 255), B = math.floor(espCfg.TreeColor.B * 255)},
                FishColor = {R = math.floor(espCfg.FishColor.R * 255), G = math.floor(espCfg.FishColor.G * 255), B = math.floor(espCfg.FishColor.B * 255)}
            },
            Caves = cavesData
        }))
    end)
    if not ok then warn("[Config] Ошибка при сохранении:", err) end
end

LoadConfig()
_G.SaveConfig    = SaveConfig
_G.SaveESPConfig = SaveConfig

